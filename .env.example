# 本番の接続情報。**このファイルの写しである .env は git に載せない**
#
#   cp .env.example .env  してから中身を埋める。.env は .gitignore 済み。

# PostgreSQL。アプリと同じ VM の中から繋ぐので localhost でよい
DATABASE_URL=postgres://eigyo:PASSWORD@localhost:5432/eigyo

# Cloudflare R2 (毎日の控え置き場)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=eigyo1-backup

# 画面を合言葉なしで公開するか (1 で公開)
EIGYO_PUBLIC=1
